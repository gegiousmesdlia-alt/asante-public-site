rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isAdmin() { return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }

    // Public catalogue — anyone can read, only admins can write.
    match /listings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /agents/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Users manage their own profile/favorites only.
    match /users/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    // Anyone can submit an enquiry; only admins can read the inbox.
    match /enquiries/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Reviews — public can read only published (approved) ones; admins can
    // read everything (including unpublished/demo), and only admins can
    // approve, reply to, or delete a review. Signed-in buyers may create
    // their own review (held unpublished until an admin approves it).
    match /reviews/{id} {
      allow read: if isAdmin() || resource.data.approved == true;
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // Bookings are written only by the server (Admin SDK via webhook),
    // never directly from client code — so no client write rule exists.
    match /bookings/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Admin whitelist — never client-writable; add entries from the Firebase console.
    match /admins/{uid} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Third-party API keys entered through the admin panel's Settings tab
    // (e.g. RealtyAPI). Never publicly readable — the serverless functions
    // that actually use these keys read them via the Firebase Admin SDK,
    // which bypasses these rules entirely, so this only governs direct
    // client-side access (the admin panel UI itself).
    match /settings/integrations {
      allow read, write: if isAdmin();
    }

    // Site-wide discount percentage — public read (every visitor's browser
    // needs it to render prices), admin-only write.
    match /settings/promotions {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
